{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fullstack-assets",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    // Point this at your framework's build output (dist, build/client, ...).
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Static files are served without invoking the Worker. Only these paths run code.
    "run_worker_first": ["/api/*"]
  }
}
