{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "container",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "AppContainer",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 2
    }
  ],
  // Each container instance is controlled by one Durable Object of this class.
  "durable_objects": {
    "bindings": [{ "name": "APP_CONTAINER", "class_name": "AppContainer" }]
  },
  "exports": {
    "AppContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
